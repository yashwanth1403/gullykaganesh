# MapTiler vector tiles. Get a free key at https://cloud.maptiler.com/account/keys/
# Restrict it to your domains in the dashboard — it ships in the client bundle.
# Without it the map falls back to OSM raster tiles, which are visibly softer
# and are dev-only under OSM's tile usage policy.
NEXT_PUBLIC_MAPTILER_KEY=

# Supabase Postgres. Use the *transaction pooler* URL (port 6543) from
# Project Settings → Database → Connection string. drizzle-kit migrations run
# fine through it too because db/index.ts disables prepared statements.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Cloudflare R2 — photo storage. Public base URL is either the r2.dev URL or a
# custom domain attached to the bucket; it ships in the client bundle.
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=gullykaganesh

# Google Geocoding — turns a dropped pin into "Road No. 12, Banjara Hills"
# on the add form. Server-side only; never ships to the browser. Without it
# the app falls back to OSM Nominatim, which rarely knows Hyderabad's lanes.
# Enable only the Geocoding API on the key; restrict it by IP if you can.
# Free tier covers ~40k lookups a month; one lookup per settled pin.
GOOGLE_MAPS_API_KEY=

# Basemap fallback. A Protomaps .pmtiles archive of Hyderabad on the R2 bucket, read
# straight from the browser with range requests — no tile server, no metered
# API. Build one with `pmtiles extract https://build.protomaps.com/<date>.pmtiles
# hyderabad.pmtiles --bbox=78.0,17.0,78.9,17.8` and upload it under tiles/,
# with Protomaps' fonts/ and sprites/v4/ next to it. MapTiler (key above) is
# used first while it answers; this takes over when the key is over quota.
NEXT_PUBLIC_PMTILES_URL=https://pub-xxxxxxxx.r2.dev/tiles/hyderabad-YYYYMMDD.pmtiles

# Supabase Auth. Project Settings → API. The anon/publishable key is public.
# Enable the Google provider under Authentication → Providers, and add
# https://<your-domain>/auth/callback (and http://localhost:3000/auth/callback)
# under Authentication → URL Configuration → Redirect URLs.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
