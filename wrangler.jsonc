{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gullykaganesh",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Plain vars. Secrets (DATABASE_URL fallback, R2_*, GOOGLE_MAPS_API_KEY)
  // are set with `wrangler secret put`, never here. NEXT_PUBLIC_* values are
  // inlined at build time from .env.local, so they need no runtime entry.
  "vars": {
    "NEXTJS_ENV": "production"
  },
  // ISR revalidation and revalidatePath() fan out through the worker itself.
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "gullykaganesh" }],
  // Pooled, in-region connections to Supabase. Create with
  //   wrangler hyperdrive create gullykaganesh-db --connection-string="<Supabase direct connection, port 5432>"
  // and paste the returned id below. db/index.ts falls back to DATABASE_URL
  // when the binding is absent (local dev, `next build` prerendering).
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<HYPERDRIVE_ID>" }],
  // Next's ISR/data cache. A separate bucket from the photos one — the
  // adapter writes under incremental-cache/ and it should not share a
  // public bucket. Create with `wrangler r2 bucket create gullykaganesh-cache`.
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "gullykaganesh-cache" }],
  // Durable Objects back the ISR queue (time-based revalidate on / and /top)
  // and the tag cache that makes revalidatePath("/") work after a submission.
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
      { "name": "NEXT_TAG_CACHE_DO_SHARDED", "class_name": "DOShardedTagCache" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"] }],
  // /_next/image — map pins and thumbnails are all optimised variants of
  // the R2 uploads. Billed per unique transformation past the free tier.
  "images": { "binding": "IMAGES" },
  "observability": { "enabled": true }
}
